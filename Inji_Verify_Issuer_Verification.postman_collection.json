          "name": "0.1 Valid VC, no parameter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"verificationStatus is SUCCESS\", () => pm.expect(j.verificationStatus).to.eql(\"SUCCESS\"));",
                  "if (pm.collectionVariables.get(\"featureEnabled\") !== \"true\") {",
                  "  pm.test(\"feature disabled: no issuerVerification key\", () => pm.expect(j).to.not.have.property(\"issuerVerification\"));",
                  "}"
                ]
              }
            }
