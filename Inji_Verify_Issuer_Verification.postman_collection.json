    {
      "name": "2. Policy A (strict registry) - one fixture per run",
      "item": [
        {
          "name": "2.1 Active issuer -> TRUSTED",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"verificationStatus is SUCCESS\", () => pm.expect(j.verificationStatus).to.eql(\"SUCCESS\"));",
                  "pm.test(\"issuerVerification present\", () => pm.expect(j.issuerVerification).to.be.an(\"object\"));",
                  "const iv = j.issuerVerification || {};",
                  "pm.test(\"overallStatus is TRUSTED\", () => pm.expect(iv.overallStatus).to.eql(\"TRUSTED\"));",
                  "pm.test(\"displayStatus is TRUSTED_ISSUER\", () => pm.expect(iv.displayStatus).to.eql(\"TRUSTED_ISSUER\"));",
                  "",
                  "pm.test(\"no internal details leaked\", () => {",
                  "  const s = JSON.stringify(j);",
                  "  pm.expect(s).to.not.match(/stack|Exception|java\\.|127\\.0\\.0\\.1|169\\.254|bearer/i);",
                  "});",
                  "",
                  "pm.test(\"check SIGNATURE_KEY_AUTHORIZED is PASS\", () => {",
                  "  const c = (iv.checks || []).find(x => x.id === \"SIGNATURE_KEY_AUTHORIZED\");",
                  "  pm.expect(c, \"check present\").to.be.an(\"object\");",
                  "  pm.expect(c.status).to.eql(\"PASS\");",
                  "});",
                  "",
                  "pm.test(\"check ISSUER_REGISTERED is PASS\", () => {",
                  "  const c = (iv.checks || []).find(x => x.id === \"ISSUER_REGISTERED\");",
                  "  pm.expect(c, \"check present\").to.be.an(\"object\");",
                  "  pm.expect(c.status).to.eql(\"PASS\");",
                  "});",
                  "",
                  "pm.test(\"check CREDENTIAL_TYPE_AUTHORIZED is PASS\", () => {",
                  "  const c = (iv.checks || []).find(x => x.id === \"CREDENTIAL_TYPE_AUTHORIZED\");",
                  "  pm.expect(c, \"check present\").to.be.an(\"object\");",
                  "  pm.expect(c.status).to.eql(\"PASS\");",
                  "});",
                  "",
                  "pm.test(\"both questions answered separately\", () => {",
                  "  pm.expect(iv.cryptographicAuthenticity).to.eql(\"VERIFIED\");",
                  "  pm.expect(iv.organizationalTrust).to.eql(\"TRUSTED\");",
                  "});",
                  "pm.test(\"issuer name comes from registry\", () => pm.expect(iv.issuerName).to.eql(\"QA Test Authority\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{vc_valid}}"
            },
            "url": {
              "raw": "{{baseUrl}}/vc-verification?verifyIssuer=true",
